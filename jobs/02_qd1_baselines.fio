; Zero-queue baselines: one request in flight at a time (QD=1, numjobs=1).
; Reads first, writes last, so write-induced background work (GC, SLC flush)
; does not disturb the read measurements.
[global]
ioengine=windowsaio
direct=1
filename=C\:\fiotest\testfile
size=64G
iodepth=1
numjobs=1
time_based=1
runtime=30
ramp_time=5
randrepeat=0
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
percentile_list=50:95:99:99.9

[randread_4k_qd1]
rw=randread
bs=4k
stonewall

[seqread_128k_qd1]
rw=read
bs=128k
stonewall

[randwrite_4k_qd1]
rw=randwrite
bs=4k
stonewall

[seqwrite_128k_qd1]
rw=write
bs=128k
stonewall
